 "lines": {
  "arrive": [
   {
    "voice": "narrator",
    "text": "Ambrose carried her into Tallyfold. Half the orchard had gone grey."
   },
   {
    "voice": "narrator",
    "who": "Wren",
    "text": "Please, can you help us? My children haven't eaten since yesterday."
   },
   {
    "voice": "narrator",
    "who": "Hobb",
    "text": "Hands off! Those trees are for winter!"
   },
   {
    "voice": "narrator",
    "text": "Nobody in Tallyfold could remember how many apples they needed. The Grey had taken that too."
   },
   {
    "voice": "ambrose",
    "text": "Your lamp shows what people forget. Go and talk to the woman at the gate."
   }
  ],
  "ask": {
   "wren": [
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "We need {total} apples to last us the week."
    },
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "Each tree by the gate gives {per} when you shake it."
    },
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "Shake as many trees as we need, then tip the apples into my basket and tell me."
    }
   ],
   "hobb": [
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "There are {people} of us, and each of us needs {each} apples to get through the winter."
    },
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "These old trees give {per} apples each."
    },
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "Chalk the trees I may take, and not one more. The rest are for the village. Then come and tell me."
    }
   ],
   "farmer": [
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "There are {total} saplings on the cart, and each row takes {per}."
    },
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "Dig the rows first, enough for every sapling, even if the last row is short."
    },
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "When the rows are dug, come to the cart and I'll tell you if they'll do."
    }
   ]
  },
  "go": {
   "hobb": [
    {
     "voice": "ambrose",
     "text": "The man in the barn is Hobb. He has forgotten how many apples his family needs. Go and ask him."
    }
   ],
   "farmer": [
    {
     "voice": "ambrose",
     "text": "There's a farmer sitting by that bare field. His saplings will die on the cart if nobody plants them. Go and see him."
    }
   ]
  },
  "refuse": [
   {
    "voice": "narrator",
    "who": "Farmer",
    "text": "Leave it be. If I can't remember, nobody expects anything of me."
   },
   {
    "voice": "ambrose",
    "text": "Help him anyway."
   }
  ],
  "short": {
   "wren": [
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "That isn't enough to last us the week. Let your lamp show you."
    }
   ],
   "hobb": [
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "That won't see us through the winter. Let your lamp show you."
    }
   ],
   "farmer": [
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "Not every sapling has a row. Let your lamp show you."
    }
   ]
  },
  "many": {
   "wren": [
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "That's more than we need. Put the extra in the village crate by the road."
    }
   ],
   "hobb": [
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "That's more than our share. Rub some out."
    }
   ],
   "farmer": [
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "Some rows would stand empty. Fill in the ones you don't need."
    }
   ]
  },
  "copy": {
   "wren": [
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "Here, let's fill it together, row by row."
    }
   ],
   "hobb": [
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "Here, we'll chalk them together."
    }
   ],
   "farmer": [
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "Here, I'll mark the rows. You dig them."
    }
   ]
  },
  "right": {
   "wren": [
    {
     "voice": "narrator",
     "who": "Wren",
     "text": "That will last us the week. Thank you, whoever you are."
    },
    {
     "voice": "narrator",
     "text": "The trees by the gate took back their colour."
    }
   ],
   "hobb": [
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "Just enough for the winter, and plenty left for the village."
    },
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "You've Nettie's look about you. You're Nettie's girl, aren't you?"
    },
    {
     "voice": "narrator",
     "text": "Helping him had lifted the Grey from one small memory. His old trees took back their colour."
    }
   ],
   "farmer": [
    {
     "voice": "narrator",
     "who": "Farmer",
     "text": "That will do. Fetch the saplings from the cart, one row at a time."
    }
   ]
  },
  "leftovers": [
   {
    "voice": "ambrose",
    "text": "There are a few apples left on the far trees. Who should have them? Take them to Hobb, to me, or to the side of the road."
   }
  ],
  "choice": {
   "hobb": [
    {
     "voice": "narrator",
     "who": "Hobb",
     "text": "More? Bless you, Nettie's girl."
    }
   ],
   "ambrose": [
    {
     "voice": "ambrose",
     "text": "That'll keep these old legs going."
    }
   ],
   "road": [
    {
     "voice": "narrator",
     "text": "She left them by the road for whoever passed. Something in the Grey sniffed the air."
    }
   ]
  },
  "daughter": [
   {
    "voice": "narrator",
    "who": "Farmer",
    "text": "I planted the first row of this orchard with my daughter, Tamsin."
   },
   {
    "voice": "narrator",
    "who": "Farmer",
    "text": "She went away to Tidemark Harbour. If you ever get there, tell her the orchard is growing again."
   },
   {
    "voice": "narrator",
    "text": "Remembering hurt him a little. He kept the memory anyway."
   }
  ],
  "night": [
   {
    "voice": "narrator",
    "text": "By dusk, the whole orchard had its colour back."
   },
   {
    "voice": "ambrose",
    "text": "The orchard remembers."
   },
   {
    "voice": "narrator",
    "text": "That night, words wrote themselves on her map, in a hand she almost knew."
   },
   {
    "voice": "gran",
    "text": "Find me before it reaches the sea."
   },
   {
    "voice": "ambrose",
    "text": "That's Nettie's hand. She's out there, ahead of the Grey. We'll go after her."
   }
  ]
 },
